NODE_ENV=development
PORT=3002
MONGO_URL=mongodb://localhost:27017/santa-notifications
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://santa:santa123@localhost:5672
LOG_LEVEL=info
# santa-api, called over HTTP to enrich consumed events. Use http://santa-api:3001 in Docker.
SANTA_API_URL=http://localhost:3001
# Shared secret sent as X-Service-Key to santa-api /api/internal/* — must match santa-api.
SERVICE_API_KEY=dev-service-key-change-in-production
# Same secret santa-api signs its JWTs with; this service only verifies them.
JWT_SECRET=change-me-in-production
