NODE_ENV=development
PORT=3002
LOG_LEVEL=info
MONGO_URL=mongodb://localhost:27017/santa-notifications
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# URL of the santa-api service (used to verify users and fetch room data)
SANTA_API_URL=http://localhost:3001
JWT_SECRET=change-me-in-production
SERVICE_API_KEY=change-me-in-production
# Comma-separated allowed origins for CORS (the Vite frontend). Defaults to http://localhost:5173
CORS_ORIGIN=http://localhost:5173
